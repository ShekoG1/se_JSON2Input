
{
  "database": {
    "host": "localhost",
    "port": 5432,
    "user": "oneapi",
    "password": "securepassword",
    "name": "mydatabase",
    "tables":[
      {
        "name": "test_auth",
        "is_auth_table": true,
        "columns": [
          {"name": "id", "type": "text", "primary_key": true},
          {"name": "email", "type": "text"},
          {"name": "password", "type": "text"},
          {"name": "bearer_token", "type": "text"},
          {"name": "token_used", "type": "text"},
          {"name": "token_expirey", "type": "text"},
          {"name": "created_at", "type": "text"}
        ],
        "security": {
          "allowed_operations": ["SELECT","INSERT","UPDATE"]
        }
      },
      {
        "name": "user",
        "is_auth_table": false,
        "encryption": {
          "enabled": true,
          "fields": ["uid"],
          "method": "AES256"
        },
        "columns": [
          {
            "name": "id",
            "type": "int",
            "primary_key": true
          },
          {
            "name": "uid",
            "type": "text",
            "nullable": false
          },
          {
            "name": "f_name",
            "type": "text",
            "nullable": true
          },
          {
            "name": "m_name",
            "type": "text",
            "nullable": true
          },
          {
            "name": "l_name",
            "type": "text",
            "nullable": true
          },
          {
            "name": "pref_name",
            "type": "text",
            "nullable": true
          },
          {
            "name": "mobile_number",
            "type": "text",
            "nullable": true
          }
        ],
        "security": {
          "allowed_operations": ["SELECT","INSERT","UPDATE"]
        }
      }
    ]
  },
  "routes": [
    {
      "name": "user/get",
      "action": "getByField",
      "table": "user",
      "auth_required": false,
      "parameters": [
        { "name": "email", "type": "string", "required": true, "table_field": "uid" }
      ],
      "conditions": [
        {
            "field":"f_name",
            "operator": "=",
            "value": "$email"
        }
      ]
    },
    {
      "name": "user/add",
      "action": "insertRow",
      "table": "user",
      "return_row": true,
      "auth_required": true,
      "parameters": [
        { "name": "email", "type": "string", "required": true },
        { "name": "fName", "type": "string", "required": true },
        { "name": "lName", "type": "string", "required": true },
        { "name": "mName", "type": "string", "required": true },
        { "name": "prefName", "type": "string", "required": true }
      ],
      "data": [
        {
            "field":"uid",
            "value": "$email"
        },
        {
            "field":"f_name",
            "value": "$fName"
        },
        {
            "field":"m_name",
            "value": "$mName"
        },
        {
            "field":"l_name",
            "value": "$lName"
        },
        {
            "field":"pref_name",
            "value": "$prefName"
        }
      ]
    },
    {
      "name": "user/update",
      "action": "updateRow",
      "table": "user",
      "return_row": true,
      "auth_required": true,
      "parameters": [
        { "name": "mobileNumber", "type": "string", "required": true }
      ],
      "data": [
        {
            "field":"pref_name",
            "value": "Snuggles"
        },
        {
            "field":"mobile_number",
            "value": "$mobileNumber"
        }
      ],
      "conditions": [
        {
            "field":"id",
            "operator": "=",
            "value": "30" 
        }
      ]
    },
    {
      "name": "user/upsert",
      "action": "upsertRow",
      "table": "user",
      "return_row": true,
      "auth_required": true,
      "parameters": [
        { "name": "mobileNumber", "type": "string", "required": true }
      ],
      "data": [
        {
            "field":"mobile_number",
            "value": "$mobileNumber"
        }
      ],
      "conditions": [
        {
            "field":"id",
            "operator": ">",
            "value": "0"
        }
      ]
    },
    {
      "name": "user/delete",
      "action": "deleteByConditions",
      "table": "user",
      "auth_required": true,
      "parameters": [
        { "name": "email", "type": "string", "required": true, "table_field": "uid" },
        { "name": "token", "type": "string", "required": true, "is_oneAPI_auth_token": true }
      ],
      "conditions": [
        {
            "field":"uid",
            "operator": "=",
            "value": "$email"
        }
      ]
    }
  ]
}